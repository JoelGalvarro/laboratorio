#include <iostream>

using namespace std;
 int main () {
  int n ;

  double suma = 0.0 ;
   cout<<"Ingrese el valor de N : " ;
   cin>> n;

   if (n <= 0){

        cout<<"Deber ser un numero positivo : " << endl;
            return 1;

        }

    for(int i = 1 ; i<= n ; i++){
        suma= suma + (1/i);
    }

    cout<<"La suma total es : " << suma << endl;
    return 0 ;


}
