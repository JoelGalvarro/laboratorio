#include <iostream>
using namespace std;

const int MAX_EVALUACIONES = 100;

int leerCantidadEvaluaciones();
void leerNotas(double notas[], int n);
double calcularPromedio(const double notas[], int n);
bool determinarAprobado(double promedio, double notaMinima);
void mostrarResultados(double promedio, bool aprobado);

int main() {
    int n = leerCantidadEvaluaciones();
    double notas[MAX_EVALUACIONES];

    leerNotas(notas, n);
    double promedio = calcularPromedio(notas, n);
    bool aprobado = determinarAprobado(promedio, 51.0);
    mostrarResultados(promedio, aprobado);

    return 0;
}

int leerCantidadEvaluaciones() {
    int n = 0;
    do {
        cout << "Ingrese la cantidad de evaluaciones (1 a " << MAX_EVALUACIONES << "): ";
        cin >> n;
        if (cin.fail() || n < 1 || n > MAX_EVALUACIONES) {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "Cantidad invalida. Intente nuevamente.\n";
            n = 0;
        }
    } while (n < 1 || n > MAX_EVALUACIONES);
    return n;
}

void leerNotas(double notas[], int n) {
    for (int i = 0; i < n; i++) {
        do {
            cout << "Ingrese la nota de la evaluacion " << (i + 1) << " (0 a 100): ";
            cin >> notas[i];
            if (cin.fail() || notas[i] < 0.0 || notas[i] > 100.0) {
                cin.clear();
                cin.ignore(10000, '\n');
                cout << "Nota invalida. Debe estar entre 0 y 100.\n";
                notas[i] = -1.0;
            }
        } while (notas[i] < 0.0 || notas[i] > 100.0);
    }
}

double calcularPromedio(const double notas[], int n) {
    double suma = 0.0;
    for (int i = 0; i < n; i++) {
        suma += notas[i];
    }
    return suma / n;
}

bool determinarAprobado(double promedio, double notaMinima) {
    return promedio >= notaMinima;
}

void mostrarResultados(double promedio, bool aprobado) {
    cout << "\n--- Resultado del estudiante ---\n";
    cout << "Promedio: " << promedio << "\n";
    if (aprobado) {
        cout << "Estado: APROBADO\n";
    } else {
        cout << "Estado: REPROBADO\n";
    }
}
